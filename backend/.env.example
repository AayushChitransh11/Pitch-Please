PORT=4000
FRONTEND_ORIGIN=http://localhost:8080
ELEVENLABS_API_KEY=
AWS_REGION=us-west-2
# Use a Converse-compatible model or inference-profile ID available in your account.
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# AWS SDK uses your normal credential chain (AWS profile locally, IAM role in AWS).
# Optional: AWS_PROFILE=your-profile

# Headless LibreOffice executable for DOC/DOCX/PPT/PPTX/TXT conversion
LIBREOFFICE_BIN=soffice
